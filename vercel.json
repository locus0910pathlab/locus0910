{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd Locus-FE/locusfe && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "Locus-FE/locusfe/build",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
