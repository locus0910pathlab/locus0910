# Database Connection String
# For local SQLite:
# DATABASE_URL=sqlite:///./locuslab.db

# For Supabase PostgreSQL:
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<dbname>

# Allowed CORS Origins (comma separated, or left empty for defaults)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://locus0910.vercel.app
